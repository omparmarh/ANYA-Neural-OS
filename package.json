{
  "name": "anya-neural-os",
  "version": "2.0.0",
  "description": "ANYA Neural AI Operating Assistant",
  "author": "ANYA AI",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && cp dist/index.html dist/200.html && npx surge dist anya-neural-os.surge.sh",
    "freellmapi": "node freellmapi/server/dist/index.js",
    "electron:dev": "NODE_ENV=development electron electron/main.cjs",
    "electron:build": "vite build && electron-builder --mac --arm64 --dir",
    "electron:dmg": "vite build && electron-builder --mac --arm64",
    "electron:win": "vite build && electron-builder --win --x64",
    "android:apk": "cd android-screener && ./gradlew assembleDebug --no-daemon && cp app/build/outputs/apk/debug/app-debug.apk ../dist/android-screener.apk",
    "android:clean": "cd android-screener && ./gradlew clean --no-daemon"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.14",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "ai.anya.neuralos",
    "productName": "ANYA",
    "icon": "public/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": false
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "freellmapi",
        "to": "freellmapi",
        "filter": [
          "server/dist/**/*",
          "server/data/**/*",
          "client/dist/**/*",
          "package.json",
          ".env",
          "freellmapi.config.json"
        ]
      }
    ],
    "directories": {
      "output": "dist-electron"
    }
  }
}
